{
  "name": "docs",
  "version": "16.0.0",
  "private": true,
  "nx": {
    "targets": {
      "sass": {
        "command": "sass ./scss/slides.scss:./css/slides.css --source-map --watch"
      },
      "sass-once": {
        "command": "sass ./scss/slides.scss:./css/slides.css --source-map"
      },
      "dev": {
        "command": "live-server --port=4242 --open=./index.html --watch=markdown,scripts/"
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "live-server --port=4242 --open=./index.html --watch=markdown,scripts/",
            "sass ./scss/slides.scss:./css/slides.css --source-map --watch"
          ],
          "parallel": true,
          "cwd": "docs"
        }
      },
      "prepare": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ./scripts/dont-touch/prepare-script.js",
          "cwd": "docs"
        }
      }
    }
  }
}