{
  "name": "@sfeir/ui-solution",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@sfeir/types": "*"
  },
  "nx": {
    "name": "ui-solution",
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "copy-assets"
        ]
      },
      "copy-assets": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "mkdir -p dist/{projectRoot} && cp -r {projectRoot}/public dist/{projectRoot}/public"
        },
        "outputs": [
          "{workspaceRoot}/dist/{projectRoot}/public"
        ],
        "inputs": [
          "{projectRoot}/public/**/*"
        ]
      }
    }
  },
  "dependencies": {
    "@sfeir/helpers": "*"
  }
}
